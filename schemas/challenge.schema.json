{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-design-platform.local/schemas/challenge.schema.json",
  "title": "Challenge",
  "description": "A learning challenge definition (authored in YAML, validated with this schema). Shape follows SYSTEM.md section 25.",
  "type": "object",
  "required": ["id", "title", "difficulty"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "difficulty": {
      "enum": ["beginner", "intermediate", "advanced", "expert"]
    },
    "mode": {
      "description": "Learning mode this challenge runs in.",
      "default": "challenge",
      "enum": ["challenge", "repair", "explore", "interview"]
    },
    "narrative": {
      "type": ["string", "null"],
      "description": "Fictional-company scenario framing."
    },
    "requirements": {
      "type": "array",
      "items": {
        "title": "ChallengeRequirement",
        "type": "object",
        "required": ["id", "category", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": {
            "enum": [
              "functional", "scale", "performance", "availability",
              "consistency", "durability", "security", "cost"
            ]
          },
          "description": { "type": "string", "minLength": 1 },
          "metric": { "type": ["string", "null"] },
          "value": { "type": ["number", "string", "null"] },
          "unit": { "type": ["string", "null"] },
          "priority": { "default": "must", "enum": ["must", "should", "could"] }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "title": "ChallengeConstraint",
        "type": "object",
        "required": ["key", "value"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "value": { "additionalProperties": true },
          "severity": { "default": "hard", "enum": ["hard", "soft"] }
        }
      }
    },
    "learning_objectives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_components": {
      "type": "array",
      "description": "Palette restriction; empty/omitted means full catalog.",
      "items": { "type": "string" }
    },
    "evaluation_rules": {
      "type": "array",
      "description": "Subset of rule ids active for scoring this challenge.",
      "items": { "type": "string", "pattern": "^[a-z]+\\.[a-z0-9_]+$" }
    },
    "scenarios": {
      "type": "array",
      "description": "Chaos/scenario event ids playable within this challenge (Phase 8 hooks).",
      "items": { "type": "string" }
    },
    "starting_graph_ref": {
      "type": ["string", "null"],
      "description": "Optional golden architecture used as the starting canvas (required for repair drills)."
    },
    "hints": {
      "type": "array",
      "description": "Ordered hint ladder: nudge -> concept -> partial structure -> full rationale.",
      "items": { "type": "string" }
    },
    "ai_context_notes": {
      "type": ["string", "null"],
      "description": "Extra context injected into tutor/coach prompts for this challenge."
    },
    "chain": {
      "title": "ChainLink",
      "description": "Progressive-chain membership (e.g. url-shortener level 2 of 6).",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "family_id": { "type": "string" },
        "level": { "type": "integer", "minimum": 1 },
        "next_challenge_id": { "type": ["string", "null"] }
      }
    },
    "related_topics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
