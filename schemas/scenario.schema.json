{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-design-platform.local/schemas/scenario.schema.json",
  "title": "ScenarioEvent",
  "description": "A chaos/scenario event definition (Phase 8). Injecting an event transforms a copy of the architecture; the engine then re-evaluates and produces a before/after delta.",
  "type": "object",
  "required": ["id", "event_type", "title"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]*$"
    },
    "event_type": {
      "enum": [
        "db_failure",
        "cache_failure",
        "queue_failure",
        "region_outage",
        "network_latency",
        "traffic_spike",
        "hot_key",
        "consumer_lag",
        "dependency_outage",
        "hit_ratio_drop",
        "custom"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "params": {
      "type": "object",
      "description": "Typed parameters per event_type (multiplier for traffic_spike, added_ms for network_latency, new_ratio for hit_ratio_drop, target_component_types...).",
      "additionalProperties": true
    },
    "applies_to": {
      "title": "AppliesTo",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component_types": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "expected_effects": {
      "type": "array",
      "description": "Documented expectations used in deterministic scenario fixtures (e.g. availability drops when no failover exists).",
      "items": {
        "title": "ExpectedEffect",
        "type": "object",
        "required": ["metric", "change"],
        "additionalProperties": false,
        "properties": {
          "metric": {
            "enum": [
              "availability", "latency_p95", "throughput", "error_rate",
              "queue_depth", "db_load", "cache_hit_ratio", "cost"
            ]
          },
          "change": { "enum": ["increase", "decrease", "degrade", "improve", "none"] },
          "condition": {
            "type": ["string", "null"],
            "description": "Guard expression on architecture state (e.g. 'no_failover', 'single_instance')."
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
