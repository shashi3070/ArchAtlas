{
  "type": "metrics_collector",
  "kind": "implementation",
  "category": "observability",
  "name": "Metrics Collector (Prometheus)",
  "description": "Pull-based time-series metrics store with PromQL and alert rule evaluation.",
  "version": "0.1.0",
  "capabilities": [
    "pull_scraping",
    "promql",
    "histogram_quantiles"
  ],
  "helps_with": [
    "golden_signal_monitoring",
    "autoscaling_signal_source"
  ],
  "does_not_solve": [
    "full_text_log_analysis",
    "distributed_trace_waterfalls"
  ],
  "risks": [
    "cardinality_explosion",
    "scrape_target_miss"
  ],
  "common_patterns": [],
  "failure_modes": [
    "remote_write_backpressure",
    "tsdb_head_pressure"
  ],
  "tradeoffs": [
    "metric_cardinality_vs_query_cost"
  ],
  "capacity_defaults": {
    "samples_per_sec": 100000,
    "default_instances": 2
  },
  "cost_defaults": {
    "usd_per_node_month": 150
  },
  "palette": {
    "group": "Observability",
    "icon": "box",
    "color": "#0891b2"
  }
}
