{
  "type": "pubsub",
  "kind": "implementation",
  "category": "messaging",
  "name": "Pub/Sub",
  "description": "Managed topic-based publish/subscribe with fan-out to independent subscriptions.",
  "version": "0.1.0",
  "capabilities": [
    "topic_fanout",
