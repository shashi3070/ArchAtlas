    "expensive_query_dos",
    "schema_merge_conflicts"
  ],
  "tradeoffs": [
    "client_flexibility_vs_server_guardrails"
  ],
  "capacity_defaults": {
    "rps_per_instance": 8000,
    "default_instances": 2
  },
  "cost_defaults": {
    "usd_per_node_month": 120
  },
